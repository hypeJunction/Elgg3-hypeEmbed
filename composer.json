{
	"name": "hypejunction/hypeembed",
	"type": "elgg-plugin",
	"version": "4.0.0",
	"description": "Embed for Elgg",
	"homepage": "http://hypejunction.com",
	"keywords": [
		"elgg",
		"plugin",
		"embed",
		"link",
		"images",
		"shortcode"
	],
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "Ismayil Khayredinov",
			"email": "info@hypejunction.com"
		}
	],
	"require": {
		"php": ">=7.4",
		"elgg/elgg": "^4.0",
		"composer/installers": "^2.0"
	},
	"autoload": {
		"psr-4": {
			"hypeJunction\\Embed\\": "classes/hypeJunction/Embed/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	},
	"extra": {
		"elgg-plugin": {
			"id": "hypeembed"
		}
	}
}
