{
    "name": "hypejunction/hypeembed",
    "type": "elgg-plugin",
    "version": "5.0.0",
    "description": "Embed for Elgg",
    "homepage": "https://github.com/hypeJunction/hypeembed",
    "keywords": [
        "elgg",
        "plugin",
        "embed",
        "link",
        "images",
        "shortcode"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "elgg/elgg": "^5.0",
        "composer/installers": "^2.0",
        "ext-intl": "*"
    },
    "autoload": {
        "psr-4": {
            "hypeJunction\\Embed\\": "classes/hypeJunction/Embed/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "elgg-plugin": {
            "id": "hypeembed"
        }
    }
}
